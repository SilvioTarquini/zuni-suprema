# Sinal de vida do Supabase (select de 1 linha no boot+1min e a cada 6h, evita pausa por inatividade).
# Ligado por padrão em produção (NODE_ENV=production / Railway); "0" desliga, "1" liga em qualquer ambiente.
SUPABASE_KEEPALIVE=
